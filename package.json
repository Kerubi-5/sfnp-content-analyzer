{
  "name": "sfnp-content-analyzer",
  "version": "0.1.3",
  "description": "Content, sentiment, and lead-generation opportunity analyzer for Sales For Nice People (SFNP)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kerubi-5/sfnp-content-analyzer"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean --dts",
    "dev": "tsup src/index.ts --format cjs,esm --clean --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
